# Node
node_modules/

# Anything the pipeline generates from real books - these hold live financial
# data (ledger entries, bank balances, customer names). They are outputs, not
# source, and must never be committed.
dashboard-data.json
dashboard.html
site/
refresh-log.txt

# Company-specific content, optional by design. Keep local.
review.html
questions.json

# Credentials for the static-host build. Never commit.
site-credentials.bat
.env

# Remote MCP: live credentials, registered OAuth clients, audit trail.
assets/mcp-server/remote-config.json
assets/mcp-server/remote-state.json
assets/mcp-server/remote-audit.log

# Packaged skill
*.skill

# Cached API responses - live ledger data, and large. Outputs, not source.
cloud-cache/

# Cross-check sheet generated from live books.
reconciliation.md

# launchd logs from the scheduled refresh.
launchd.out.log
launchd.err.log
dashboard.prev.html

# Per-install settings: names the company and its books.
profile.json

# Per-install cost/project mapping: names product lines and business decisions.
# Commit project-map.example.json instead.
project-map.json

# Generated scheduler config: contains machine paths and the company name.
com.*.dashboard-refresh.plist
!com.example.dashboard-refresh.plist

# macOS noise
.DS_Store

# Sample exports for building the file-based route: real ledger data.
exports-sample/
../exports-sample/

# Remote MCP access tokens: one per person. Never commit.
server-tokens.txt
