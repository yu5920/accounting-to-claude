# Copy to .env in this folder and fill in. .env is excluded by .gitignore.
# Real environment variables override anything set here, so a scheduled job can
# supply credentials without a file on disk.

ACCT_ENGINE=autocount_cloud

# Settings > API Keys in the Cloud Accounting web app.
# Create the key with the write methods switched OFF - see the permission list
# in references/autocount-cloud-api.md. The key's permissions are the only real
# read-only boundary on this path.
ACCT_CLOUD_KEY_ID=
ACCT_CLOUD_API_KEY=

# Comma-separated account book ids, one per company book.
ACCT_CLOUD_BOOKS=

# Optional.
# ACCT_CLOUD_BASE=https://accounting-api.autocountcloud.com
# ACCT_CLOUD_PAGE_DELAY_MS=250    # spacing between pages; no documented rate limit
# ACCT_TIMEOUT=60                 # seconds per request
# ACCT_MAX_ROWS=2000              # rows returned to Claude per tool call
